<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabStatus"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="12dp"
      android:paddingTop="4dp">

    <!-- Статус-карточка -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
          <View
              android:id="@+id/dotStatus"
              android:layout_width="12dp"
              android:layout_height="12dp"
              android:background="@drawable/bg_dot" />
          <TextView
              android:id="@+id/txtStatus"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginStart="10dp"
              android:textColor="@color/text"
              android:textSize="17sp"
              android:textStyle="bold"
              android:text="@string/status_off" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:text="@string/hint_stopped" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:textSize="16sp"
            android:text="@string/btn_start"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:cornerRadius="14dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Лучший сервер / избранное -->
    <LinearLayout
        android:id="@+id/boxBest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_best"
        android:padding="14dp"
        android:visibility="gone">
      <TextView
          android:id="@+id/txtBestTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/text_secondary"
          android:textSize="12sp"
          android:text="@string/best_title_ping" />
      <TextView
          android:id="@+id/txtBest"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:fontFamily="monospace"
          android:textColor="@color/text"
          android:textSize="15sp"
          android:textStyle="bold"
          android:text="0.0.0.0" />
      <TextView
          android:id="@+id/txtBestGeo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/text_secondary"
          android:textSize="13sp"
          android:text="" />
      <com.google.android.material.button.MaterialButton
          android:id="@+id/btnKeepBest"
          style="@style/Widget.Material3.Button.TonalButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="@string/btn_keep_only_this"
          app:icon="@drawable/ic_star"
          app:iconGravity="textStart"
          app:cornerRadius="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowStrict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="4dp"
        android:orientation="horizontal"
        android:visibility="gone">
      <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/swStrict"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/text"
          android:textSize="13sp"
          android:text="@string/strict_switch" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnblockAll"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:text="@string/btn_unblock_all_short" />

    <TextView
        android:id="@+id/txtCounters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:text="" />

    <!-- Донат -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:background="@drawable/bg_donate"
        android:padding="16dp">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@color/text"
          android:textSize="16sp"
          android:textStyle="bold"
          android:text="@string/donate_title" />
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:textColor="@color/text_secondary"
          android:textSize="13sp"
          android:text="@string/donate_text" />
      <com.google.android.material.button.MaterialButton
          android:id="@+id/btnDonate"
          style="@style/Widget.Material3.Button"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="@string/donate_button"
          app:backgroundTint="@color/donate"
          app:icon="@drawable/ic_heart"
          app:iconGravity="textStart"
          app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHelp"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/btn_help" />
  </LinearLayout>
</ScrollView>
